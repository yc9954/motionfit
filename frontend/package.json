{
  "name": "motionfit-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "prebuild": "npm run prepare:vision",
    "predev": "npm run prepare:vision"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.17",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "0.182.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
